ENVIRONMENT=development
DEBUG=true
DATABASE_URL=postgresql+psycopg://campuswise:campuswise@localhost:5432/campuswise
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:3000"]
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-3-lite
VOYAGE_RERANK_MODEL=rerank-2-lite

# Distributed tracing. Off by default -- Docker Compose turns this on and
# points it at the bundled Jaeger service; leave off for plain local runs
# unless you have a collector running at the endpoint below.
OTEL_ENABLED=false
OTEL_EXPORTER_ENDPOINT=localhost:4317
OTEL_SERVICE_NAME=campuswise-backend
